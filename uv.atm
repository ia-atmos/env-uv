;; A libuv environment for Atmos: the network, files, and timers.
;;
;;      atmos-uv prog.atm               (the dedicated compiler: `make`)
;;
;; or, with the plain compiler and `include "uv.atm"` in the program:
;;
;;      ATMOS_LDFLAGS="-luv" atmos prog.atm
;;
;; The program runs inside the loop of libuv. Time passes with the clock of
;; the loop, so that `await 1s` and `loop on :clock` work as usual.
;;
;; The environment registers itself with `atmos.env`, in either mode:
;;  - primary (it is the first environment, or the only one): the loop of
;;    libuv waits for input or for the next timer, and gives the time;
;;  - secondary (another environment came first, such as a GUI): the loop
;;    only delivers what is ready, with no wait, and the primary gives the
;;    time.
;;
;; As the primary, it ends the program when nothing can awake it: no timer,
;; and no active handle or request of libuv.

```:prelude
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <uv.h>

///////////////////////////////////////////////////////////////////////////////
// DRIVER
///////////////////////////////////////////////////////////////////////////////

// The steps of the environment, which `atmos.env` registers below: the
// runtime calls them from its generic `main`.

static uv_loop_t* UVA_LOOP_ = NULL;
static uv_timer_t UVA_CLK;              // awakes the loop for the next timer
static uint64_t   UVA_NOW  = 0;         // time already given to the program (ms)
static uint64_t   UVA_T0   = 0;         // time of the loop when it started (ms)
static int        UVA_PRI  = 0;         // the environment is the primary
static int        UVA_QUIT = 0;         // the program is over: callbacks only release

// The loop, which starts at its first use.
static uv_loop_t* uva_loop (void) {
    if (UVA_LOOP_ == NULL) {
        UVA_LOOP_ = uv_default_loop();
        uv_timer_init(UVA_LOOP_, &UVA_CLK);
        uv_update_time(UVA_LOOP_);
        UVA_NOW = uv_now(UVA_LOOP_);
        UVA_T0  = UVA_NOW;
    }
    return UVA_LOOP_;
}

#define UVA_LOOP (uva_loop())

// Gives the program the time that passed in the loop, as the primary.
static void uva_time (void) {
    uint64_t now = uv_now(UVA_LOOP);
    if (UVA_PRI && !UVA_QUIT && now>UVA_NOW) {
        uint64_t dt = now - UVA_NOW;
        UVA_NOW = now;
        // in the unit of time of the build (A_TIME_US microseconds)
        atm_emit(a_int((AInt)(dt * 1000 / A_TIME_US)));
    }
}

static void uva_clk_cb (uv_timer_t* h) {
    (void) h;
}

// One step: as the primary, waits for input or for the next timer (`next`,
// in the unit of time of the build, or none if negative), and gives the
// time; as a secondary, only delivers
// what is ready. Returns 1 if the program must end: nothing can awake it,
// which only the primary alone may say.
//
// With secondaries, the primary waits 10ms at most, since they only run
// between its steps.
#define UVA_BOUND_MS 10
// The callbacks emit from inside `uv_run`: the runtime keeps the first
// error of their emits, and gives it as the status of the step.
static int uva_step (int primary, double next) {
    double ms = (next < 0) ? -1 : next * A_TIME_US / 1000.0;
    UVA_PRI = primary;
    uva_loop();
    uv_timer_stop(&UVA_CLK);
    if (primary) {
        if (atm_nenvs == 1 && !uv_loop_alive(UVA_LOOP) && ms<0) {
            return 1;
        }
        if (atm_nenvs>1 && (ms<0 || ms>UVA_BOUND_MS)) {
            ms = UVA_BOUND_MS;
        }
        if (ms >= 0) {
            uv_timer_start(&UVA_CLK, uva_clk_cb, (uint64_t)(ms + 0.999), 0);
        }
        fflush(stdout);
        uv_run(UVA_LOOP, UV_RUN_ONCE);
        uva_time();
    } else {
        uv_run(UVA_LOOP, UV_RUN_NOWAIT);
    }
    return 0;
}

// The quit of the environment, which the runtime calls after it released
// the values of the program, and so its handles: the handles close in two
// steps, and the loop runs the callbacks of the closes.
static void uva_quit (void) {
    UVA_QUIT = 1;
    if (UVA_LOOP_ != NULL) {
        uv_timer_stop(&UVA_CLK);
        uv_close((uv_handle_t*)&UVA_CLK, NULL);
        uv_run(UVA_LOOP_, UV_RUN_DEFAULT);
        uv_loop_close(UVA_LOOP_);
    }
}

///////////////////////////////////////////////////////////////////////////////
// ERRORS
///////////////////////////////////////////////////////////////////////////////

// A line longer than its limit: E2BIG, with a message of its own.
#define UVA_ELINE UV_E2BIG

// An error of libuv as a value: :error.<NAME> [name=, msg=]
static AVal uva_error (int r) {
    char tag[64];
    snprintf(tag, sizeof(tag), "error.%s", uv_err_name(r));
    AVal e  = a_tab();
    AVal t  = a_strz(tag);
    AVal k1 = a_strz("name");
    AVal v1 = a_strz(uv_err_name(r));
    AVal k2 = a_strz("msg");
    AVal v2 = a_strz((r == UVA_ELINE) ? "line too long" : uv_strerror(r));
    a_tag(e, t);
    a_setindex(e, k1, v1);
    a_setindex(e, k2, v2);
    a_dec(t); a_dec(k1); a_dec(v1); a_dec(k2); a_dec(v2);
    return e;
}

///////////////////////////////////////////////////////////////////////////////
// WAITING
///////////////////////////////////////////////////////////////////////////////

// A task that waits for a callback registers itself (`a_cur`) in the handle
// or request, and awaits `:read`, `:accept`, or `:done` with a predicate
// that only accepts its own awake (`UVA_WAKE`). The task removes itself
// when it terminates or aborts.
//
// The event is a broadcast (`atm_emit`), and not an emit to the task alone
// (`atm_emit_to`), which would be cheaper: an exception raised by a task
// outside the target, awoken because the target terminated, is lost by
// `atm_emit_to` (reported to atmos-lang, 2026-11-20; tst/throw-after.atm).

static struct ATask* UVA_WAKE = NULL;

static void uva_wake (struct ATask** w, const char* tag) {
    if (*w==NULL || UVA_QUIT) {
        return;
    }
    uva_time();
    if (*w == NULL) {
        return;
    }
    AVal t = a_strz(tag);
    UVA_WAKE = *w;
    atm_emit(t);
    UVA_WAKE = NULL;
    a_dec(t);
}

///////////////////////////////////////////////////////////////////////////////
// BUFFERS
///////////////////////////////////////////////////////////////////////////////

// Bytes read and not consumed, of a stream or of a file: [off,len).
typedef struct {
    char*  p;
    size_t off, len, cap;
} uva_buf;

// Makes room for at least `n` more bytes, and returns where they go.
static char* uva_buf_room (uva_buf* b, size_t n) {
    if (b->off > 0) {
        memmove(b->p, b->p+b->off, b->len-b->off);
        b->len -= b->off;
        b->off  = 0;
    }
    if (b->cap - b->len < n) {
        b->cap = (b->cap*2 > b->len+n) ? b->cap*2 : b->len+n;
        b->p   = realloc(b->p, b->cap);
    }
    return b->p + b->len;
}

// Takes bytes from a buffer:
//  - mode 0: all that it has
//  - mode 1: `n` bytes
//  - mode 2: a line, with no "\n", of at most `n` bytes
// Returns a string, or `false` if the bytes are still to come. When the
// source is over (`over` is UV_EOF or an error), returns what the buffer
// still has, then `nil` at the end, or the number of the error. A line
// that does not end within `n` bytes is the error UVA_ELINE: its bytes
// stay in the buffer.
static AVal uva_buf_take (uva_buf* b, int over, int mode, AVal vn) {
    char*  p     = b->p + b->off;
    size_t avail = b->len - b->off;
    size_t n     = 0;       // bytes of the result
    size_t skip  = 0;       // bytes to discard after them
    int    ok    = 0;
    if (mode == 0) {
        n  = avail;
        ok = (avail > 0);
    } else if (mode == 1) {
        n  = a_isnum(vn) ? (size_t)a_dbl(vn) : 0;
        ok = (avail >= n);
    } else {
        size_t max = a_isnum(vn) ? (size_t)a_dbl(vn) : (size_t)-1;
        char* nl = (avail > 0) ? memchr(p, '\n', avail) : NULL;
        if (nl!=NULL && (size_t)(nl-p)<=max) {
            n    = nl - p;
            skip = 1;
            ok   = 1;
        } else if (avail > max) {
            return a_int(UVA_ELINE);
        }
    }
    if (!ok) {
        if (over == 0) {
            return a_bool(0);
        } else if (avail > 0) {
            n = avail;
        } else if (over == UV_EOF) {
            return a_nil();
        } else {
            return a_int(over);
        }
    }
    AVal ret = a_str(p, n);
    b->off += n + skip;
    if (b->off == b->len) {
        b->off = b->len = 0;
    }
    return ret;
}

///////////////////////////////////////////////////////////////////////////////
// REQUESTS
///////////////////////////////////////////////////////////////////////////////

// A request lives until its callback runs (`done`) and its native value is
// released (`gone`), in any order.
typedef struct {
    union {
        uv_req_t     req;
        uv_connect_t connect;
        uv_write_t   write;
        uv_shutdown_t shutdown;
        uv_udp_send_t udp_send;
        uv_getaddrinfo_t getaddrinfo;
        uv_fs_t      fs;
    } u;
    struct ATask* waiter;
    int     done;           // 1, or 2 during its callback
    int     gone;
    int     cancel;         // the request can be cancelled
    int64_t res;
    AVal    val;            // a result that is a value
    int     kind;           // of a request on files
    struct uva_file* file;  // the file in use
    char    data[];
} uva_req;

static const char* UVA_KIND_REQ = "uv.req";

static void uva_req_fin (void* p) {
    uva_req* r = p;
    r->waiter = NULL;
    r->gone   = 1;
    a_dec(r->val);
    r->val = a_nil();
    if (r->done == 1) {
        free(r);
    } else if (r->done==0 && r->cancel) {
        uv_cancel(&r->u.req);
    }
}

// The callback of the request ran. The awake may release the native value
// of the request, which is only freed here (`done` is 2 meanwhile).
static void uva_req_done (uva_req* r, int64_t res) {
    r->res  = res;
    r->done = 2;
    if (!r->gone) {
        uva_wake(&r->waiter, "done");
    }
    r->done = 1;
    if (r->gone) {
        free(r);
    }
}

static AVal uva_req_new (uva_req** r, size_t extra) {
    *r = calloc(1, sizeof(uva_req) + extra);
    (*r)->waiter = a_cur;
    (*r)->val    = a_nil();
    return a_nat(*r, uva_req_fin, UVA_KIND_REQ);
}

///////////////////////////////////////////////////////////////////////////////
// STREAMS
///////////////////////////////////////////////////////////////////////////////

typedef struct {
    union {
        uv_handle_t handle;
        uv_stream_t stream;
        uv_tcp_t    tcp;
    } u;
    struct ATask* waiter;   // task that reads or accepts
    int    pending;         // server: connections to accept
    int    err;             // the stream is over: UV_EOF or an error
    int    reading;         // between uv_read_start and uv_read_stop
    uva_buf buf;            // bytes read and not consumed
} uva_stream;

static const char* UVA_KIND_STREAM = "uv.stream";

static void uva_stream_free (uv_handle_t* h) {
    uva_stream* s = (uva_stream*) h;
    free(s->buf.p);
    free(s);
}

// The close has two steps: the memory is released in the callback.
static void uva_stream_fin (void* p) {
    uva_stream* s = p;
    s->waiter = NULL;
    uv_close(&s->u.handle, uva_stream_free);
}

static uva_stream* uva_stream_of (AStatus* st, AVal v) {
    if (!a_nat_is(v,UVA_KIND_STREAM)) {
        *st = a_error("invalid stream");
        return NULL;
    }
    if (a_nat_ptr(v) == NULL) {
        *st = a_error("invalid stream : closed");
        return NULL;
    }
    return a_nat_ptr(v);
}

// The running task waits for the stream: only one at a time.
static void uva_stream_wait (AStatus* st, AVal v) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return;
    }
    if (s->waiter != NULL) {
        *st = a_error("invalid stream : busy");
        return;
    }
    s->waiter = a_cur;
}

static void uva_stream_unwait (AVal v, int reading) {
    uva_stream* s = a_nat_ptr(v);
    if (s!=NULL && s->waiter==a_cur) {
        s->waiter = NULL;
        if (reading && s->reading) {
            uv_read_stop(&s->u.stream);
            s->reading = 0;
        }
    }
}

// READ

static void uva_alloc_cb (uv_handle_t* h, size_t hint, uv_buf_t* buf) {
    uva_stream* s = (uva_stream*) h;
    (void) hint;
    char* p = uva_buf_room(&s->buf, 4096);
    *buf = uv_buf_init(p, s->buf.cap - s->buf.len);
}

static void uva_read_cb (uv_stream_t* h, ssize_t n, const uv_buf_t* buf) {
    uva_stream* s = (uva_stream*) h;
    (void) buf;
    if (n > 0) {
        s->buf.len += n;
    } else if (n < 0) {
        s->err = n;
        uv_read_stop(h);
        s->reading = 0;
    } else {
        return;
    }
    uva_wake(&s->waiter, "read");
}

static int uva_read_start (AStatus* st, AVal v) {
    uva_stream* s = uva_stream_of(st, v);
    if (s==NULL || s->err!=0 || s->reading) {
        return 0;
    }
    int err = uv_read_start(&s->u.stream, uva_alloc_cb, uva_read_cb);
    s->reading = (err == 0);
    return err;
}

static AVal uva_take (AStatus* st, AVal v, int mode, AVal vn) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    return uva_buf_take(&s->buf, s->err, mode, vn);
}

// WRITE

static void uva_write_cb (uv_write_t* w, int status) {
    uva_req_done((uva_req*)w, status);
}

static AVal uva_write (AStatus* st, AVal v, AVal str) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    if (str.type != A_STR) {
        *st = a_error("invalid write : expected string");
        return a_nil();
    }
    size_t n = A_STR_OF(str)->len;
    uva_req* r;
    AVal ret = uva_req_new(&r, n);
    memcpy(r->data, A_STR_OF(str)->s, n);
    uv_buf_t buf = uv_buf_init(r->data, n);
    int err = uv_write(&r->u.write, &s->u.stream, &buf, 1, uva_write_cb);
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    }
    return ret;
}

// SHUTDOWN

static void uva_shutdown_cb (uv_shutdown_t* r, int status) {
    uva_req_done((uva_req*)r, status);
}

static AVal uva_shutdown (AStatus* st, AVal v) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    int err = uv_shutdown(&r->u.shutdown, &s->u.stream, uva_shutdown_cb);
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    }
    return ret;
}

///////////////////////////////////////////////////////////////////////////////
// TCP
///////////////////////////////////////////////////////////////////////////////

static AVal uva_tcp_new (void) {
    uva_stream* s = calloc(1, sizeof(uva_stream));
    uv_tcp_init(UVA_LOOP, &s->u.tcp);
    return a_nat(s, uva_stream_fin, UVA_KIND_STREAM);
}

// An address of IPv4 or IPv6. Returns 0, or an error.
static int uva_addr (AStatus* st, AVal ip, AVal port, struct sockaddr_storage* addr) {
    if (ip.type!=A_STR || !a_isnum(port)) {
        *st = a_error("invalid address : expected ip and port");
        return 0;
    }
    int err = uv_ip4_addr(A_STR_OF(ip)->s, (int)a_dbl(port), (struct sockaddr_in*)addr);
    if (err < 0) {
        err = uv_ip6_addr(A_STR_OF(ip)->s, (int)a_dbl(port), (struct sockaddr_in6*)addr);
    }
    return err;
}

// A table with the ip and the port of an address, at the indexes `i` and
// `i+1`.
static AVal uva_name_tab (struct sockaddr* addr, int i) {
    char ip[64] = "";
    int  port;
    if (addr->sa_family == AF_INET6) {
        uv_ip6_name((struct sockaddr_in6*)addr, ip, sizeof(ip));
        port = ntohs(((struct sockaddr_in6*)addr)->sin6_port);
    } else {
        uv_ip4_name((struct sockaddr_in*)addr, ip, sizeof(ip));
        port = ntohs(((struct sockaddr_in*)addr)->sin_port);
    }
    AVal t = a_tab();
    AVal x = a_strz(ip);
    a_setindex(t, a_int(i), x);
    a_setindex(t, a_int(i+1), a_int(port));
    a_dec(x);
    return t;
}

// [ip, port] of a stream, or of its peer.
static AVal uva_tcp_name (AStatus* st, AVal v, int peer) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    struct sockaddr_storage addr;
    int len = sizeof(addr);
    int err = peer
        ? uv_tcp_getpeername(&s->u.tcp, (struct sockaddr*)&addr, &len)
        : uv_tcp_getsockname(&s->u.tcp, (struct sockaddr*)&addr, &len);
    if (err < 0) {
        return a_int(err);
    }
    return uva_name_tab((struct sockaddr*)&addr, 0);
}

// CONNECT

static void uva_connect_cb (uv_connect_t* c, int status) {
    uva_req_done((uva_req*)c, status);
}

static AVal uva_tcp_connect (AStatus* st, AVal v, AVal ip, AVal port) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    struct sockaddr_storage addr;
    int err = uva_addr(st, ip, port, &addr);
    if (*st != A_OK) {
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    if (err == 0) {
        err = uv_tcp_connect(&r->u.connect, &s->u.tcp, (struct sockaddr*)&addr, uva_connect_cb);
    }
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    }
    return ret;
}

// LISTEN

static void uva_listen_cb (uv_stream_t* h, int status) {
    uva_stream* s = (uva_stream*) h;
    if (status < 0) {
        s->err = status;
    } else {
        s->pending++;
    }
    uva_wake(&s->waiter, "accept");
}

static int uva_tcp_listen (AStatus* st, AVal v, AVal ip, AVal port, AVal backlog) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return 0;
    }
    struct sockaddr_storage addr;
    int err = uva_addr(st, ip, port, &addr);
    if (*st!=A_OK || err<0) {
        return err;
    }
    err = uv_tcp_bind(&s->u.tcp, (struct sockaddr*)&addr, 0);
    if (err < 0) {
        return err;
    }
    return uv_listen(&s->u.stream, a_isnum(backlog) ? (int)a_dbl(backlog) : 128, uva_listen_cb);
}

// A pending connection as a new stream, or `false` if there is none, or the
// number of the error.
static AVal uva_tcp_accept (AStatus* st, AVal v) {
    uva_stream* s = uva_stream_of(st, v);
    if (s == NULL) {
        return a_nil();
    }
    if (s->pending == 0) {
        return (s->err < 0) ? a_int(s->err) : a_bool(0);
    }
    AVal ret = uva_tcp_new();
    uva_stream* c = a_nat_ptr(ret);
    int err = uv_accept(&s->u.stream, &c->u.stream);
    s->pending--;
    if (err < 0) {
        a_dec(ret);
        return a_int(err);
    }
    return ret;
}

///////////////////////////////////////////////////////////////////////////////
// UDP
///////////////////////////////////////////////////////////////////////////////

// A datagram received and not consumed.
typedef struct uva_dgram {
    struct uva_dgram* next;
    struct sockaddr_storage addr;
    size_t len;
    char   data[];
} uva_dgram;

typedef struct {
    uv_udp_t      udp;
    struct ATask* waiter;   // task that receives
    int           err;      // an error of the receive
    int           reading;  // between uv_udp_recv_start and uv_udp_recv_stop
    uva_dgram*    head;     // datagrams received, in order
    uva_dgram*    tail;
    char          buf[65536];
} uva_udp;

static const char* UVA_KIND_UDP = "uv.udp";

static void uva_udp_free (uv_handle_t* h) {
    uva_udp* u = (uva_udp*) h;
    while (u->head != NULL) {
        uva_dgram* d = u->head;
        u->head = d->next;
        free(d);
    }
    free(u);
}

static void uva_udp_fin (void* p) {
    uva_udp* u = p;
    u->waiter = NULL;
    uv_close((uv_handle_t*)&u->udp, uva_udp_free);
}

static uva_udp* uva_udp_of (AStatus* st, AVal v) {
    if (!a_nat_is(v,UVA_KIND_UDP)) {
        *st = a_error("invalid udp");
        return NULL;
    }
    if (a_nat_ptr(v) == NULL) {
        *st = a_error("invalid udp : closed");
        return NULL;
    }
    return a_nat_ptr(v);
}

// A socket bound to an address (port 0: any free port). Returns the socket,
// or the number of the error.
static AVal uva_udp_bind (AStatus* st, AVal ip, AVal port) {
    struct sockaddr_storage addr;
    int err = uva_addr(st, ip, port, &addr);
    if (*st != A_OK) {
        return a_nil();
    }
    if (err < 0) {
        return a_int(err);
    }
    uva_udp* u = calloc(1, sizeof(uva_udp));
    uv_udp_init(UVA_LOOP, &u->udp);
    AVal ret = a_nat(u, uva_udp_fin, UVA_KIND_UDP);
    err = uv_udp_bind(&u->udp, (struct sockaddr*)&addr, 0);
    if (err < 0) {
        a_dec(ret);
        return a_int(err);
    }
    return ret;
}

static void uva_udp_alloc_cb (uv_handle_t* h, size_t hint, uv_buf_t* buf) {
    uva_udp* u = (uva_udp*) h;
    (void) hint;
    *buf = uv_buf_init(u->buf, sizeof(u->buf));
}

static void uva_udp_recv_cb (uv_udp_t* h, ssize_t n, const uv_buf_t* buf,
                             const struct sockaddr* addr, unsigned flags) {
    uva_udp* u = (uva_udp*) h;
    (void) flags;
    if (n < 0) {
        u->err = n;
    } else if (addr == NULL) {
        return;                     // nothing more to read now
    } else {
        uva_dgram* d = malloc(sizeof(uva_dgram) + n);
        d->next = NULL;
        d->len  = n;
        memcpy(d->data, buf->base, n);
        memcpy(&d->addr, addr, (addr->sa_family == AF_INET6)
            ? sizeof(struct sockaddr_in6) : sizeof(struct sockaddr_in));
        if (u->tail == NULL) {
            u->head = u->tail = d;
        } else {
            u->tail->next = d;
            u->tail = d;
        }
    }
    uva_wake(&u->waiter, "read");
}

static void uva_udp_wait (AStatus* st, AVal v) {
    uva_udp* u = uva_udp_of(st, v);
    if (u == NULL) {
        return;
    }
    if (u->waiter != NULL) {
        *st = a_error("invalid udp : busy");
        return;
    }
    u->waiter = a_cur;
}

static void uva_udp_unwait (AVal v) {
    uva_udp* u = a_nat_ptr(v);
    if (u!=NULL && u->waiter==a_cur) {
        u->waiter = NULL;
        if (u->reading) {
            uv_udp_recv_stop(&u->udp);
            u->reading = 0;
        }
    }
}

static int uva_udp_recv_start (AStatus* st, AVal v) {
    uva_udp* u = uva_udp_of(st, v);
    if (u==NULL || u->reading) {
        return 0;
    }
    int err = uv_udp_recv_start(&u->udp, uva_udp_alloc_cb, uva_udp_recv_cb);
    u->reading = (err == 0);
    return err;
}

// The next datagram as [data, ip, port], or `false` if none arrived, or the
// number of an error.
static AVal uva_udp_take (AStatus* st, AVal v) {
    uva_udp* u = uva_udp_of(st, v);
    if (u == NULL) {
        return a_nil();
    }
    if (u->head == NULL) {
        if (u->err < 0) {
            int err = u->err;
            u->err = 0;
            return a_int(err);
        }
        return a_bool(0);
    }
    uva_dgram* d = u->head;
    u->head = d->next;
    if (u->head == NULL) {
        u->tail = NULL;
    }
    AVal t = uva_name_tab((struct sockaddr*)&d->addr, 1);
    AVal x = a_str(d->data, d->len);
    a_setindex(t, a_int(0), x);
    a_dec(x);
    free(d);
    return t;
}

static void uva_udp_send_cb (uv_udp_send_t* q, int status) {
    uva_req_done((uva_req*)q, status);
}

static AVal uva_udp_send (AStatus* st, AVal v, AVal ip, AVal port, AVal str) {
    uva_udp* u = uva_udp_of(st, v);
    if (u == NULL) {
        return a_nil();
    }
    if (str.type != A_STR) {
        *st = a_error("invalid send : expected string");
        return a_nil();
    }
    struct sockaddr_storage addr;
    int err = uva_addr(st, ip, port, &addr);
    if (*st != A_OK) {
        return a_nil();
    }
    size_t n = A_STR_OF(str)->len;
    uva_req* r;
    AVal ret = uva_req_new(&r, n);
    memcpy(r->data, A_STR_OF(str)->s, n);
    uv_buf_t buf = uv_buf_init(r->data, n);
    if (err == 0) {
        err = uv_udp_send(&r->u.udp_send, &u->udp, &buf, 1,
            (struct sockaddr*)&addr, uva_udp_send_cb);
    }
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    }
    return ret;
}

// [ip, port] of the socket.
static AVal uva_udp_name (AStatus* st, AVal v) {
    uva_udp* u = uva_udp_of(st, v);
    if (u == NULL) {
        return a_nil();
    }
    struct sockaddr_storage addr;
    int len = sizeof(addr);
    int err = uv_udp_getsockname(&u->udp, (struct sockaddr*)&addr, &len);
    if (err < 0) {
        return a_int(err);
    }
    return uva_name_tab((struct sockaddr*)&addr, 0);
}

///////////////////////////////////////////////////////////////////////////////
// NAMES
///////////////////////////////////////////////////////////////////////////////

// The addresses of a name, as a vector of strings with no repetition.
static void uva_getaddrinfo_cb (uv_getaddrinfo_t* g, int status, struct addrinfo* res) {
    uva_req* r = (uva_req*) g;
    if (status==0 && !r->gone) {
        r->val = a_tab();
        int n = 0;
        for (struct addrinfo* p=res; p!=NULL; p=p->ai_next) {
            char ip[64] = "";
            if (p->ai_family == AF_INET) {
                uv_ip4_name((struct sockaddr_in*)p->ai_addr, ip, sizeof(ip));
            } else if (p->ai_family == AF_INET6) {
                uv_ip6_name((struct sockaddr_in6*)p->ai_addr, ip, sizeof(ip));
            } else {
                continue;
            }
            AVal x = a_strz(ip);
            int dup = 0;
            for (int i=0; i<n; i++) {
                dup = dup || a_eq(a_tab_get(A_TAB_OF(r->val),a_int(i)), x);
            }
            if (!dup) {
                a_setindex(r->val, a_int(n++), x);
            }
            a_dec(x);
        }
    }
    uv_freeaddrinfo(res);
    uva_req_done(r, status);
}

static AVal uva_getaddrinfo (AStatus* st, AVal name) {
    if (name.type != A_STR) {
        *st = a_error("invalid name : expected string");
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    struct addrinfo hints;
    memset(&hints, 0, sizeof(hints));
    hints.ai_socktype = SOCK_STREAM;
    int err = uv_getaddrinfo(UVA_LOOP, &r->u.getaddrinfo, uva_getaddrinfo_cb,
        A_STR_OF(name)->s, NULL, &hints);
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    } else {
        r->cancel = 1;
    }
    return ret;
}

// The string is an address of IPv4 or IPv6.
static int uva_is_ip (AVal ip) {
    struct sockaddr_storage addr;
    return ip.type==A_STR && (
        uv_ip4_addr(A_STR_OF(ip)->s, 0, (struct sockaddr_in*)&addr)==0 ||
        uv_ip6_addr(A_STR_OF(ip)->s, 0, (struct sockaddr_in6*)&addr)==0);
}

///////////////////////////////////////////////////////////////////////////////
// FILES
///////////////////////////////////////////////////////////////////////////////

// A file is released after its native value is released (`gone`) and its
// requests in course are over (`pending`): a request may be running in a
// thread, and the descriptor must not be reused before it ends.
typedef struct uva_file {
    uv_file fd;
    int     gone;
    int     pending;
    int     reading;        // a read is in course
    int     append;
    int     eof;
    int64_t pos;            // position of the next byte to read or write
    uva_buf buf;            // bytes read ahead, from `pos` on
} uva_file;

enum { UVA_FS_OTHER, UVA_FS_OPEN, UVA_FS_READ, UVA_FS_STAT };

static const char* UVA_KIND_FILE = "uv.file";

#define UVA_FS_CHUNK 65536

static void uva_file_free (uva_file* f) {
    uv_fs_t q;
    uv_fs_close(UVA_LOOP, &q, f->fd, NULL);
    uv_fs_req_cleanup(&q);
    free(f->buf.p);
    free(f);
}

static void uva_file_fin (void* p) {
    uva_file* f = p;
    f->gone = 1;
    if (f->pending == 0) {
        uva_file_free(f);
    }
}

static uva_file* uva_file_of (AStatus* st, AVal v) {
    if (!a_nat_is(v,UVA_KIND_FILE)) {
        *st = a_error("invalid file");
        return NULL;
    }
    if (a_nat_ptr(v) == NULL) {
        *st = a_error("invalid file : closed");
        return NULL;
    }
    return a_nat_ptr(v);
}

static AVal uva_file_new (AVal fd, AVal append) {
    uva_file* f = calloc(1, sizeof(uva_file));
    f->fd     = (uv_file) a_dbl(fd);
    f->append = a_truthy(append);
    return a_nat(f, uva_file_fin, UVA_KIND_FILE);
}

static void uva_stat_set (AVal t, const char* k, AVal v) {
    AVal key = a_strz(k);
    a_setindex(t, key, v);
    a_dec(key);
}

static void uva_fs_cb (uv_fs_t* q) {
    uva_req* r   = (uva_req*) q;
    int64_t  res = q->result;
    if (r->kind==UVA_FS_OPEN && res>=0 && r->gone) {
        // opened for a task that is gone
        uv_fs_t c;
        uv_fs_close(UVA_LOOP, &c, (uv_file)res, NULL);
        uv_fs_req_cleanup(&c);
    }
    if (r->kind==UVA_FS_STAT && res==0 && !r->gone) {
        uv_stat_t* b = &q->statbuf;
        r->val = a_tab();
        uva_stat_set(r->val, "size",  a_numi((AReal)b->st_size));
        uva_stat_set(r->val, "mode",  a_int(b->st_mode & 07777));
        uva_stat_set(r->val, "mtime", a_numi((AReal)b->st_mtim.tv_sec));
        uva_stat_set(r->val, "file",  a_bool(S_ISREG(b->st_mode)));
        uva_stat_set(r->val, "dir",   a_bool(S_ISDIR(b->st_mode)));
    }
    uv_fs_req_cleanup(q);
    uva_file* f = r->file;
    if (f != NULL) {
        r->file = NULL;
        if (r->kind == UVA_FS_READ) {
            f->reading = 0;
        }
        if (--f->pending==0 && f->gone) {
            uva_file_free(f);
        }
    }
    uva_req_done(r, res);
}

// A request on files: `err` is the result of the call that starts it.
static AVal uva_fs_started (AVal ret, uva_req* r, uva_file* f, int err) {
    if (err < 0) {
        r->res  = err;
        r->done = 1;
    } else {
        r->cancel = 1;
        if (f != NULL) {
            r->file = f;
            f->pending++;
        }
    }
    return ret;
}

// "r", "w", "a", with an optional "+", as `fopen`.
static AVal uva_fs_open (AStatus* st, AVal path, AVal mode, AVal perm) {
    const char* m = (mode.type == A_STR) ? A_STR_OF(mode)->s : "r";
    int plus  = (strchr(m,'+') != NULL);
    int flags = plus ? UV_FS_O_RDWR : (m[0]=='r' ? UV_FS_O_RDONLY : UV_FS_O_WRONLY);
    if (m[0] == 'w') {
        flags |= UV_FS_O_CREAT | UV_FS_O_TRUNC;
    } else if (m[0] == 'a') {
        flags |= UV_FS_O_CREAT | UV_FS_O_APPEND;
    } else if (m[0] != 'r') {
        *st = a_error("invalid open : invalid mode");
        return a_nil();
    }
    if (path.type != A_STR) {
        *st = a_error("invalid open : expected path");
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    r->kind = UVA_FS_OPEN;
    return uva_fs_started(ret, r, NULL, uv_fs_open(UVA_LOOP, &r->u.fs,
        A_STR_OF(path)->s, flags, a_isnum(perm) ? (int)a_dbl(perm) : 0644, uva_fs_cb));
}

// Reads the next chunk, after what the buffer has.
static AVal uva_fs_read (AStatus* st, AVal v) {
    uva_file* f = uva_file_of(st, v);
    if (f == NULL) {
        return a_nil();
    }
    if (f->reading) {
        *st = a_error("invalid file : busy");
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, UVA_FS_CHUNK);
    r->kind = UVA_FS_READ;
    uv_buf_t buf = uv_buf_init(r->data, UVA_FS_CHUNK);
    int err = uv_fs_read(UVA_LOOP, &r->u.fs, f->fd, &buf, 1,
        f->pos + (int64_t)(f->buf.len - f->buf.off), uva_fs_cb);
    f->reading = (err >= 0);
    return uva_fs_started(ret, r, f, err);
}

// Moves the chunk of a read into the buffer of the file.
static void uva_fs_fill (AStatus* st, AVal v, AVal req) {
    uva_file* f = uva_file_of(st, v);
    uva_req*  r = a_nat_ptr(req);
    if (f==NULL || r==NULL) {
        return;
    }
    if (r->res == 0) {
        f->eof = 1;
    } else if (r->res > 0) {
        memcpy(uva_buf_room(&f->buf, r->res), r->data, r->res);
        f->buf.len += r->res;
    }
}

static AVal uva_fs_take (AStatus* st, AVal v, int mode, AVal vn) {
    uva_file* f = uva_file_of(st, v);
    if (f == NULL) {
        return a_nil();
    }
    size_t before = f->buf.len - f->buf.off;
    AVal ret = uva_buf_take(&f->buf, f->eof ? UV_EOF : 0, mode, vn);
    if (ret.type == A_NIL) {
        f->eof = 0;         // a file may grow: the next read tries again
    } else if (ret.type == A_STR) {
        f->pos += before - (f->buf.len - f->buf.off);
    }
    return ret;
}

// Writes the bytes of the string from `off` on, at the position of the file.
static AVal uva_fs_write (AStatus* st, AVal v, AVal str, AVal off) {
    uva_file* f = uva_file_of(st, v);
    if (f == NULL) {
        return a_nil();
    }
    if (str.type != A_STR) {
        *st = a_error("invalid write : expected string");
        return a_nil();
    }
    size_t o = (size_t) a_dbl(off);
    size_t n = A_STR_OF(str)->len - o;
    uva_req* r;
    AVal ret = uva_req_new(&r, n);
    memcpy(r->data, A_STR_OF(str)->s+o, n);
    uv_buf_t buf = uv_buf_init(r->data, n);
    return uva_fs_started(ret, r, f, uv_fs_write(UVA_LOOP, &r->u.fs, f->fd,
        &buf, 1, f->append ? -1 : f->pos, uva_fs_cb));
}

// The position of the file moves: what was read ahead is discarded.
static void uva_fs_seek (AStatus* st, AVal v, int64_t pos) {
    uva_file* f = uva_file_of(st, v);
    if (f != NULL) {
        f->pos = pos;
        f->eof = 0;
        f->buf.off = f->buf.len = 0;
    }
}

static int64_t uva_fs_tell (AStatus* st, AVal v) {
    uva_file* f = uva_file_of(st, v);
    return (f == NULL) ? 0 : f->pos;
}

// Of an open file, or of a path.
static AVal uva_fs_stat (AStatus* st, AVal v) {
    uva_file* f = NULL;
    if (v.type != A_STR) {
        f = uva_file_of(st, v);
        if (f == NULL) {
            return a_nil();
        }
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    r->kind = UVA_FS_STAT;
    return uva_fs_started(ret, r, f, (f != NULL)
        ? uv_fs_fstat(UVA_LOOP, &r->u.fs, f->fd, uva_fs_cb)
        : uv_fs_stat(UVA_LOOP, &r->u.fs, A_STR_OF(v)->s, uva_fs_cb));
}

static AVal uva_fs_unlink (AStatus* st, AVal path) {
    if (path.type != A_STR) {
        *st = a_error("invalid unlink : expected path");
        return a_nil();
    }
    uva_req* r;
    AVal ret = uva_req_new(&r, 0);
    return uva_fs_started(ret, r, NULL,
        uv_fs_unlink(UVA_LOOP, &r->u.fs, A_STR_OF(path)->s, uva_fs_cb));
}
```

;; Throws the error of a result of libuv, or returns the result.
func uv_chk (r) {
    if (type(r) == :number) && (r < 0) {
        throw `:value uva_error((int)a_dbl($r))`
    }
    r
}

;; Awaits a request, and returns its result.
task uv_req (r) {
    if !`:boolean ((uva_req*)a_nat_ptr($r))->done` {
        `((uva_req*)a_nat_ptr($r))->waiter = a_cur;`
        await :done until `:boolean UVA_WAKE == a_cur`
    }
    uv_chk(`:number ((uva_req*)a_nat_ptr($r))->res`)
}

task uv_stream_take (s, mode, n) {
    `uva_stream_wait(&st, $s);`
    defer {
        `uva_stream_unwait($s, 1);`
    }
    loop {
        val v = uv_chk(`:value uva_take(&st, $s, (int)a_dbl($mode), $n)`)
        if v != false {
            break v
        }
        uv_chk(`:number uva_read_start(&st, $s)`)
        await :read until `:boolean UVA_WAKE == a_cur`
    }
}

task uv_stream_read (s, n) {
    await uv_stream_take(s, (if n==nil => 0 => 1), n)
}

task uv_stream_line (s, max) {
    await uv_stream_take(s, 2, max || 65536)
}

task uv_stream_write (s, str) {
    pin r = `:value uva_write(&st, $s, $str)`
    await uv_req(r)
}

task uv_udp_recv (u) {
    `uva_udp_wait(&st, $u);`
    defer {
        `uva_udp_unwait($u);`
    }
    loop {
        val d = uv_chk(`:value uva_udp_take(&st, $u)`)
        if d != false {
            break d
        }
        uv_chk(`:number uva_udp_recv_start(&st, $u)`)
        await :read until `:boolean UVA_WAKE == a_cur`
    }
}

task uv_udp_send (u, ip, port, str) {
    pin r = `:value uva_udp_send(&st, $u, $ip, $port, $str)`
    await uv_req(r)
}

task uv_stream_shutdown (s) {
    pin r = `:value uva_shutdown(&st, $s)`
    await uv_req(r)
}

func uv_tcp_listen (ip, port, backlog) {
    val s = `:value uva_tcp_new()`
    uv_chk(`:number uva_tcp_listen(&st, $s, $ip, $port, $backlog)`)
    s
}

task uv_tcp_accept (srv) {
    `uva_stream_wait(&st, $srv);`
    defer {
        `uva_stream_unwait($srv, 0);`
    }
    loop {
        val c = uv_chk(`:value uva_tcp_accept(&st, $srv)`)
        if c != false {
            break c
        }
        await :accept until `:boolean UVA_WAKE == a_cur`
    }
}

task uv_dns_lookup (name) {
    pin r = `:value uva_getaddrinfo(&st, $name)`
    await uv_req(r)
    `:value (a_inc(((uva_req*)a_nat_ptr($r))->val), ((uva_req*)a_nat_ptr($r))->val)`
}

task uv_tcp_connect_ip (ip, port) {
    val s = `:value uva_tcp_new()`
    pin r = `:value uva_tcp_connect(&st, $s, $ip, $port)`
    await uv_req(r)
    s
}

;; A name is resolved, and its addresses are tried in order.
task uv_tcp_connect (host, port) {
    if (type(host) != :string) || `:boolean uva_is_ip($host)` {
        return await uv_tcp_connect_ip(host, port)
    }
    val ips = await uv_dns_lookup(host)
    if #ips == 0 {
        throw `:value uva_error(UV_EAI_NONAME)`
    }
    loop i,ip in ips {
        if i == #ips-1 {
            ;; the last address: its error is the error of the connect
            return await uv_tcp_connect_ip(ip, port)
        }
        val ok, s = catch :error {
            await uv_tcp_connect_ip(ip, port)
        }
        if ok {
            return s
        }
    }
}

task uv_fs_open (path, mode, perm) {
    pin r = `:value uva_fs_open(&st, $path, $mode, $perm)`
    val fd = await uv_req(r)
    val append = (mode != nil) && (string.find(mode, "a") != nil)
    `:value uva_file_new($fd, $append)`
}

task uv_fs_take (f, mode, n) {
    loop {
        val v = uv_chk(`:value uva_fs_take(&st, $f, (int)a_dbl($mode), $n)`)
        if v != false {
            break v
        }
        pin r = `:value uva_fs_read(&st, $f)`
        await uv_req(r)
        `uva_fs_fill(&st, $f, $r);`
    }
}

task uv_fs_read (f, n) {
    await uv_fs_take(f, (if n==nil => 0 => 1), n)
}

task uv_fs_line (f, max) {
    await uv_fs_take(f, 2, max || 65536)
}

task uv_fs_write (f, str) {
    var off = 0
    loop {
        pin r = `:value uva_fs_write(&st, $f, $str, $off)`
        val n = await uv_req(r)
        set off = off + n
        `uva_fs_seek(&st, $f, uva_fs_tell(&st,$f) + (int64_t)a_dbl($n));`
        until off >= #str
    }
    off
}

task uv_fs_stat (f) {
    pin r = `:value uva_fs_stat(&st, $f)`
    await uv_req(r)
    `:value (a_inc(((uva_req*)a_nat_ptr($r))->val), ((uva_req*)a_nat_ptr($r))->val)`
}

task uv_fs_unlink (path) {
    pin r = `:value uva_fs_unlink(&st, $path)`
    await uv_req(r)
}

;; An error of libuv in a client only terminates that client, which owns
;; its connection.
task uv_tcp_client (handler, pin s, ...) {
    catch :error {
        await handler(s, ...)
    }
}

task uv_tcp_serve (srv, handler, ...) {
    pin cs = tasks()
    loop {
        spawn @cs uv_tcp_client(handler, await uv_tcp_accept(srv), ...)
    }
}

pin uv = [
    ;; uv.now(): the time of the loop, in milliseconds since it started
    now = func () {
        `:number.integer (uv_now(UVA_LOOP) - UVA_T0)`
    },

    ;; uv.close(h): closes a handle now, before its last reference
    close = func (h) {
        `if ($h.type == A_NAT) { a_nat_close($h); }`
    },

    stream = [
        ;; await uv.stream.read(s): the bytes that arrive, as a string
        ;; await uv.stream.read(s, n): exactly `n` bytes
        ;; At the end of the stream: what is left, then nil.
        read = uv_stream_read,

        ;; await uv.stream.line(s, [max]): a line, with no "\n", of at most
        ;; `max` bytes (default 64K), else the error :error.E2BIG.
        ;; At the end of the stream: what is left, then nil.
        line = uv_stream_line,

        ;; await uv.stream.write(s, str): writes all bytes of the string
        write = uv_stream_write,

        ;; await uv.stream.shutdown(s): ends the writes, after the pending
        ;; ones: the other side reads the end of the stream
        shutdown = uv_stream_shutdown,
    ],

    fs = [
        ;; await uv.fs.open(path, [mode], [perm]): a file. The mode is "r"
        ;; (default), "w", or "a", with an optional "+", as `fopen`.
        open = uv_fs_open,

        ;; await uv.fs.read(f): the next bytes of the file, as a string
        ;; await uv.fs.read(f, n): exactly `n` bytes
        ;; At the end of the file: what is left, then nil.
        read = uv_fs_read,

        ;; await uv.fs.line(f, [max]): a line, with no "\n", of at most
        ;; `max` bytes (default 64K), else the error :error.E2BIG.
        ;; At the end of the file: what is left, then nil.
        line = uv_fs_line,

        ;; await uv.fs.write(f, str): writes all bytes of the string
        write = uv_fs_write,

        ;; uv.fs.seek(f, pos): the position of the next read or write
        seek = func (f, pos) {
            `uva_fs_seek(&st, $f, (int64_t)a_dbl($pos));`
        },

        ;; uv.fs.tell(f): the position of the next read or write
        tell = func (f) {
            `:value a_numi((AReal)uva_fs_tell(&st, $f))`
        },

        ;; await uv.fs.stat(f): [size=, mode=, mtime=, file=, dir=] of an
        ;; open file, or of a path
        stat = uv_fs_stat,

        ;; await uv.fs.unlink(path): removes a file
        unlink = uv_fs_unlink,
    ],

    dns = [
        ;; await uv.dns.lookup(name): the addresses of a name, as strings
        lookup = uv_dns_lookup,
    ],

    udp = [
        ;; uv.udp.bind(ip, port): a socket of UDP, bound to the address
        ;; (port 0: any free port)
        bind = func (ip, port) {
            uv_chk(`:value uva_udp_bind(&st, $ip, $port)`)
        },

        ;; await uv.udp.send(u, ip, port, str): sends a datagram
        send = uv_udp_send,

        ;; await uv.udp.recv(u): the next datagram, as [data, ip, port]
        recv = uv_udp_recv,

        ;; uv.udp.addr(u): the ip and the port of the socket
        addr = func (u) {
            val t = uv_chk(`:value uva_udp_name(&st, $u)`)
            return t@0, t@1
        },
    ],

    tcp = [
        ;; uv.tcp.listen(ip, port, [backlog]): a server
        listen = uv_tcp_listen,

        ;; await uv.tcp.accept(srv): the next connection to the server
        accept = uv_tcp_accept,

        ;; await uv.tcp.serve(srv, T, ...): spawns `T(s, ...)` for each
        ;; connection `s` to the server, in a pool. Never terminates.
        serve = uv_tcp_serve,

        ;; await uv.tcp.connect(host, port): a connection to a server,
        ;; given by an address or by a name
        connect = uv_tcp_connect,

        ;; uv.tcp.addr(s): the ip and the port of the stream
        addr = func (s) {
            val t = uv_chk(`:value uva_tcp_name(&st, $s, 0)`)
            return t@0, t@1
        },

        ;; uv.tcp.peer(s): the ip and the port of the other side
        peer = func (s) {
            val t = uv_chk(`:value uva_tcp_name(&st, $s, 1)`)
            return t@0, t@1
        },
    ],
]

;; The environment: the runtime calls its step from its generic `main`,
;; with its mode, `:primary` or `:secondary`.
atmos.env([
    mode = [primary=true, secondary=true],
    step = func (mode) {
        val pri = (mode == :primary)
        val us  = atmos.next() || -1          ;; in the unit of the build
        `:boolean uva_step(a_truthy($pri), a_dbl($us))`
    },
    quit = func () {
        `uva_quit();`
    },
])
