;; ceu-libuv: samples/fs-10.ceu
;; Copies the file that fs-09 writes, line by line (the original then
;; compares the two files, in Lua).

pin fs = []
par :all {
    set fs.w = await uv.fs.open("/tmp/output.txt", "w")
} with {
    set fs.r = await uv.fs.open("/tmp/hello.txt")
}
loop {
    val line = await uv.fs.line(fs.r)
    until line == nil
    val n = await uv.fs.write(fs.w, line ++ "\n")
    assert(n == #line + 1)
}
print("DONE")
