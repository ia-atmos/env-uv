;; ceu-libuv: samples/tcp-03.ceu
;; Two parallel "echo" servers, on ports 7000 and 7001.

task Client (client) {
    loop {
        val buf = await uv.stream.read(client)
        until buf == nil
        await uv.stream.write(client, buf)
    }
    print("[client]: end of file")
}

task Server (ip, port) {
    pin server = uv.tcp.listen(ip, port)
    pin cs = tasks(10)
    loop {
        spawn @cs Client(await uv.tcp.accept(server))
    }
}

spawn Server("0.0.0.0", 7000)
spawn Server("0.0.0.0", 7001)

print("I will terminate after 10s...")
await 10s
print("DONE!")
