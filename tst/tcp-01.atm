;; ceu-libuv: samples/tcp-01.ceu
;; A sequential "echo" server: one client at a time, and it terminates
;; after two connections.
;; Test: port 0, and two clients in the program, which connect together:
;; the second only gets its echo after the first closes.

include "../uv.atm"

val srv = uv.tcp.listen("127.0.0.1", 0)
val ip, port = uv.tcp.addr(srv)

task Test (id) {
    val c = await uv.tcp.connect(ip, port)
    await uv.stream.write(c, "hello from " ++ id)
    print("[client " ++ id ++ "] " ++ await uv.stream.read(c))
    await 10ms
}
spawn Test(1)
spawn Test(2)

print("I will terminate after two connections...")

loop i in 2 {
    print(">>> " ++ i)
    val client = await uv.tcp.accept(srv)
    loop {
        val buf = await uv.stream.read(client)
        if buf == nil {
            print("[read]: end of file")
            break
        }
        await uv.stream.write(client, buf)
    }
}

print("DONE!")
