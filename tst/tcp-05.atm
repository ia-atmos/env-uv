;; ceu-libuv: samples/tcp-05.ceu and samples/tcp-06.ceu
;; A sequential "echo" client. The two samples differ in Céu in how they
;; connect (the request and its event against `UV_TCP_Connect`); here
;; there is one way.
;; Test: port 0, 3 messages at each 10ms (the original: 10, at each 1s),
;; and the echo server in the program (the original: `nc`).

task Echo (s) {
    loop {
        val buf = await uv.stream.read(s)
        until buf == nil
        await uv.stream.write(s, buf)
    }
}
val srv = uv.tcp.listen("127.0.0.1", 0)
val ip, port = uv.tcp.addr(srv)
spawn uv.tcp.serve(srv, Echo)

val c = await uv.tcp.connect(ip, port)

loop i in 3 {
    await 10ms
    await uv.stream.write(c, "Alo mundo!\n")
    val str = await uv.stream.line(c)
    print(str)
}

print("DONE!")
