;; ceu-libuv: samples/fs-05.ceu
;; Writes 20 lines with the alphabet to a file, and checks its contents.
;; Test: the file goes to build/, and is read back in the program (the
;; original compares it with `fs-03.txt.orig` in Lua).

val path = "../build/tst/fs-03.txt"
val abc  = "abcdefghijklmnopqrstuvwxyz\n"

do {
    val f = await uv.fs.open(path, "w")
    loop in 20 {
        val n = await uv.fs.write(f, abc)
        assert(n == 27)
    }
}

val f = await uv.fs.open(path)
var n = 0
loop {
    val line = await uv.fs.line(f)
    until line == nil
    assert(line ++ "\n" == abc)
    set n = n + 1
}
print(n, (await uv.fs.stat(f)).size)
print("DONE")
