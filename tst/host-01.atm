;; Hosted: another environment owns `main`, its loop, and the time, and
;; drives libuv with `uva_poll`. Here the host is this prelude: it sleeps
;; 1ms, gives the time to the program, and polls. The program is an echo
;; server and its client, as in any other test.
;;
;; Built with the plain compiler, `-DUVA_NO_MAIN`, and the `include`.

```:prelude
#define _POSIX_C_SOURCE 199309L
#include <stdio.h>
#include <time.h>

AStatus uva_poll    (void);
int     uva_pending (void);
void    uva_close   (void);

int main (int argc, char** argv) {
    atm_init(argc, argv);
    AStatus st = atm_main();
    int steps = 0;
    while (st==A_OK && atm_alive() && (uva_pending() || atm_next()>=0)) {
        struct timespec ts = { 0, 1000000 };
        nanosleep(&ts, NULL);
        st = atm_emit(a_int(1000));         // the time of the host
        if (st == A_OK) {
            st = uva_poll();
        }
        steps++;
    }
    if (st == A_OK) {
        st = atm_stop();
    }
    if (st != A_OK) {
        a_error_dump();
    }
    atm_quit();
    uva_close();
    printf("host: %s\n", (steps > 0) ? "stepped" : "no steps");
    return (st == A_OK) ? 0 : 1;
}
```

include "../uv.atm"

task Echo (s) {
    loop {
        val line = await uv.stream.line(s)
        until line == nil
        await uv.stream.write(s, line ++ "\n")
    }
}

pin srv = uv.tcp.listen("127.0.0.1", 0)
val ip, port = uv.tcp.addr(srv)
spawn uv.tcp.serve(srv, Echo)

do {
    pin c = await uv.tcp.connect(ip, port)
    loop i in 3 {
        await 10ms                          ;; a timer of the host
        await uv.stream.write(c, "hello " ++ i ++ "\n")
        print((await uv.stream.line(c)))
    }
}

;; an error of libuv still reaches the program
val ok, e = catch :error {
    await uv.fs.open("/non/existent/path")
}
print(ok, e.name)

;; a task aborted by the time of the host
pin srv2 = uv.tcp.listen("127.0.0.1", 0)
watching 20ms {
    await uv.tcp.accept(srv2)
    print("never")
}
print("done")
