;; A chat server: each line that a client sends goes to all the others.
;;
;;      ./atmos-uv exs/chat.atm [port]          (default 7000)
;;      nc localhost 7000                       (in two or more terminals)

val port = tonumber(...) || 7000

task Client (s, id) {
    par :any {
        ;; from this client to the others
        loop {
            val line = await uv.stream.line(s)
            until line == nil
            emit @:global (:msg [from=id, text=line])
        }
    } with {
        ;; from the others to this client
        loop e on :msg {
            if e.from != id {
                await uv.stream.write(s, e.from ++ "> " ++ e.text ++ "\n")
            }
        }
    }
    emit @:global (:msg [from=id, text="(left)"])
}

pin srv = uv.tcp.listen("0.0.0.0", port)
pin cs  = tasks()
loop id {
    spawn @cs Client(await uv.tcp.accept(srv), id)
}
